# ==============================================================================
# AI Multi-Agent Research Assistant — Backend Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ==============================================================================

# ── LLM Providers ─────────────────────────────────────────────────────────────
# OpenRouter (main writer LLM — gpt-oss-120b via openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mistral AI (light LLM — planner, summarizer, critic)
MISTRAL_API_KEY=your_mistral_api_key_here

# Cerebras (optional LLM — configured in agents.py)
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Groq (optional LLM — configured in agents.py)
GROQ_API_KEY=your_groq_api_key_here

# ── Search ─────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── API Layer ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# Local dev: keep as-is.
# Production: add your deployed Vercel URL, e.g.:
#   ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# Optional: set to true to include exception details in 500 responses (local dev only)
DEBUG=false

# ── LangSmith tracing ──────────────────────────────────────────────────────────
# Set LANGSMITH_TRACING=true and add your API key to enable LangSmith traces.
# When unset or false the app behaves exactly as without langsmith installed.
# Get your key at: https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ResearchForge
